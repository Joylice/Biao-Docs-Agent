# ── 测试环境配置模板（复制为 1panel.env 或 .env.test 并填写真实值）──
# 测试环境配置固化：每次发版无需变更，数据库重置后自动从环境变量恢复
# 密钥仅存于服务器 1panel.env，不提交 Git

# ── 基础安全（必须修改）──
BID_JWT_SECRET=change-me-to-random-64chars
BID_MINIO_ACCESS_KEY=bidadmin
BID_MINIO_SECRET_KEY=change-me-strong-password

# ── LLM 大模型（测试环境：智谱 GLM-4.6V）──
BID_LLM_MODEL=zhipu/glm-4.6v
BID_LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
BID_LLM_API_KEY=sk-填写智谱APIKey
BID_LLM_MOCK=false

# ── 云端提供商 API Key（可选，按需填写）──
BID_DEEPSEEK_API_KEY=
BID_DASHSCOPE_API_KEY=
BID_ZHIPU_API_KEY=sk-填写智谱APIKey
BID_OPENAI_API_KEY=
BID_ANTHROPIC_API_KEY=
BID_MOONSHOT_API_KEY=

# ── Embedding 向量模型（测试环境：自定义 bge-m3）──
BID_EMBEDDING_MODEL=jiaorong-bge-m3
BID_EMBEDDING_API_BASE=https://c4ai.cccltd.cn/api/compatible/v1
BID_EMBEDDING_API_KEY=sk-填写EmbeddingKey
BID_EMBEDDING_DIMENSION=1024

# ── 管理员（可访问模型设置页面）──
BID_ADMIN_USER_IDS=admin@bidagent.com

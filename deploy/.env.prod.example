# ── 生产部署密钥模板（复制为 .env.prod 并填写真实值）──
# 供 docker compose --env-file .env.prod -f docker-compose.prod.yml 读取
# 注意：.env.prod 已被 .gitignore 排除，严禁提交真实密钥

# 生产 JWT 签名密钥（必填，>=32 字符随机串；后端 validate_runtime_secrets 会拒绝默认值）
BID_JWT_SECRET=

# MinIO 根账号（8~16 字符）
BID_MINIO_ACCESS_KEY=

# MinIO 根密码（8~40 字符，建议 32 位随机）
BID_MINIO_SECRET_KEY=

# ── LLM API Keys（可选，按需填入；不填则使用设置页配置的自定义端点）──
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

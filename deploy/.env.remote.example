# ── 测试环境远端部署参数模板（复制为 .env.remote 并填写真实值）──
# .env.remote 已被 .gitignore 排除，严禁提交真实密码/密钥

# ── 1Panel 面板连接 ──
PANEL_URL=http://192.168.18.200:20000
PANEL_ENTRANCE=tech
PANEL_USER=root
PANEL_PASS=changeme

# ── 面板 API 接口（推荐，免验证码全自动）──
# 开启方式：1Panel → 设置 → 安全 → API 接口：开启 + 生成 API Key
#           IP 白名单必须配置（填本机出口 IP 或 0.0.0.0/0），否则报 "IP whitelist is empty"
PANEL_API_KEY=
# 备选：浏览器登录面板后从 DevTools 复制 Cookie 字符串（psession=...; SecurityEntrance=...），
#       用于 PANEL_API_KEY 未配置时（session 有效期 24h，过期需手动刷新）
PANEL_COOKIES=

# ── 部署目标 ──
REMOTE_DIR=/opt/bidagent
REMOTE_UPLOAD_DIR=/opt
REMOTE_COMPOSE=/opt/bidagent/deploy/docker-compose.offline.yml
COMPOSE_NAME=deploy

# ── 健康检查地址（本机直连，绕开代理）──
API_HEALTH_URL=http://192.168.18.200:18000/health
WEB_URL=http://192.168.18.200:5173

# ── 容器镜像名（与 docker-compose.offline.yml 保持一致）──
APP_IMAGE_PREFIX=bidagent

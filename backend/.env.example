# ── 应用 ──
BID_DEBUG=false
BID_API_PREFIX=/api/v1

# ── 数据库 ──
BID_DATABASE_URL=postgresql+psycopg://bid:bid@localhost:5432/bid

# ── Redis ──
BID_REDIS_URL=redis://localhost:6379/0

# ── JWT ──
BID_JWT_SECRET=change-me-in-production
BID_JWT_ALGORITHM=HS256
BID_JWT_ACCESS_EXPIRE_MINUTES=120
BID_JWT_REFRESH_EXPIRE_DAYS=7

# ── MinIO ──
BID_MINIO_ENDPOINT=localhost:9000
BID_MINIO_ACCESS_KEY=minioadmin
BID_MINIO_SECRET_KEY=minioadmin
BID_MINIO_BUCKET=bid-documents
BID_MINIO_SECURE=false

# ── LLM ──
BID_LLM_MOCK=true
BID_LLM_MODEL=deepseek/deepseek-chat
BID_LLM_PRIMARY=deepseek/deepseek-chat
BID_LLM_BACKUP=qwen/qwen-plus

# ── Embedding ──
BID_EMBEDDING_MODEL=bge-m3
BID_EMBEDDING_DIMENSION=1024
BID_EMBEDDING_API_BASE=http://localhost:11434/v1

# ── Upload ──
BID_MAX_UPLOAD_SIZE_MB=50

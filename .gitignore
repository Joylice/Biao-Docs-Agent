# 环境配置（含密钥，严禁入库）
.env
.env.prod
.env.remote
.env.*.local

# Python
.venv/
# 损坏的 .venv 原地重命名留存（2026-09-18 git rm 事故连带损伤 site-packages，仅本地排查用）
.venv_broken_*/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
# pytest 临时目录：本机 harness 有「单轮 >50 删除目标即杀进程」的门禁，
# 故本地一律用 --basetemp=<工作区内目录> 规避临时目录 GC，这些目录不入库。
.pytest_*/

# Node
node_modules/
dist/
# 前端 build 验证副本（frontend/scripts/verify-clone-snapshot.mjs 本地留档用）
# 🔴 2026-09-18：dist-verify{,2..13} 共 782 个构建产物曾被误入库（32.2 MB），
#    此处补上忽略规则并 git rm --cached 摘除（磁盘文件保留）。
dist-verify*/
*.tsbuildinfo

# IDE tools
.qoder/

# E2E test artifacts
e2e/playwright-report/
e2e/test-results/

# 本机人工查验脚本（Playwright 截图/扫描，依赖 output/_dev_account.txt 本地凭据）
e2e/_dev_*.cjs

# Vite 配置编译产物（源文件为 vite.config.ts）
frontend/vite.config.js
frontend/vite.config.d.ts

# 运行产物
output/
backend/_logs/

# 本地工作区状态（IDE 会话/记忆，不入库）
.workbuddy/

# Canvas 交付报告（本地产物，不入库）
*.canvas.tsx
*.canvas.status.json

# Vite 构建临时文件
*.timestamp-*.mjs
deploy/.admin_cred.txt
.git-rewrite/

# 镜像恢复中转目录（仅本地留存，不入库）
backend/_superseded_img_*/

# 损坏的 .git 对象库留存（2026-09-18 恢复时原地重命名保留，仅本地排查用，不入库）
_superseded_git_broken_*/
# 仓库外 git 恢复中转目录（clone 用，不入库）
_git_recover_*/
